// Prisma schema for the Coffee Shop Ordering System.
// All monetary values are stored as integer centavos, or Decimal(14, 4) for unit costs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STAFF
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  pin          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  GCASH
}

enum IngredientUnit {
  G
  ML
  PC
}

enum MovementReason {
  OPENING
  SALE
  RETURN
  RESTOCK
  ADJUSTMENT
  WASTE
}

enum CostReview {
  NONE
  PENDING
  CONFIRMED
  DISMISSED
}

enum ExpenseCategory {
  RENT
  WAGES
  UTILITIES
  SUPPLIES
  OTHER
}

model Ingredient {
  id                   String                 @id @default(cuid())
  name                 String
  category             String?
  unit                 IngredientUnit
  stockQty             Decimal                @default(0) @db.Decimal(14, 3) // base units, may go negative
  unitCostCents        Decimal?               @db.Decimal(14, 4)             // NULL = unknown cost
  costUpdatedAt        DateTime?                                             // effective time of current cost
  costSourceMovementId String?                                               // restock that set it (null = manual edit)
  lowStockThreshold    Decimal                @default(0) @db.Decimal(14, 3)
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  movements            StockMovement[]
  menuItemIngredients MenuItemIngredient[]
  sizeIngredients     SizeIngredient[]
  addOnIngredients    AddOnIngredient[]

  @@index([archivedAt])
  @@index([category])
}

// Recipe lines: all use onDelete: Cascade from the owner, onDelete: Restrict to Ingredient
model MenuItemIngredient {
  menuItemId   String
  ingredientId String
  qty          Decimal    @db.Decimal(12, 3)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([menuItemId, ingredientId])
  @@index([ingredientId])
}

model SizeIngredient {
  sizeId       String
  ingredientId String
  qtyDelta     Decimal      @db.Decimal(12, 3) // may be negative
  size         MenuItemSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([sizeId, ingredientId])
  @@index([ingredientId])
}

model AddOnIngredient {
  addOnId      String
  ingredientId String
  qty          Decimal       @db.Decimal(12, 3)
  addOn        MenuItemAddOn @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([addOnId, ingredientId])
  @@index([ingredientId])
}

model StockMovement {
  id                String         @id @default(cuid())
  ingredientId      String
  qtyChange         Decimal        @db.Decimal(14, 3) // signed
  unitCostCents     Decimal?       @db.Decimal(14, 4) // frozen at movement time; NULL = unknown
  reason            MovementReason
  orderId           String?
  reversesId        String?        @unique            // a SALE can be reversed at most once
  reportedPaidCents Int?                              // staff-entered total paid (restock)
  costReview        CostReview     @default(NONE)
  reviewedById      String?
  reviewedAt        DateTime?
  note              String?
  createdById       String?                           // acting user, for every row written in a request
  createdAt         DateTime       @default(now())
  ingredient        Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reverses          StockMovement? @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy        StockMovement? @relation("Reversal")

  @@index([ingredientId, createdAt])
  @@index([orderId])
  @@index([reason, createdAt])
  @@index([costReview])
}

model DailyCounter {
  businessDay String @id // "YYYY-MM-DD" from getBusinessDay()
  lastNumber  Int
}

model Expense {
  id          String          @id @default(cuid())
  businessDay String          // same key format as getBusinessDay()
  category    ExpenseCategory
  amountCents Int
  note        String?
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([businessDay])
}

model MenuItem {
  id             String               @id @default(cuid())
  name           String
  description    String?
  basePriceCents Int                  // integer centavos, >= 0
  category       String
  imageUrl       String?
  available      Boolean              @default(true)
  noIngredients  Boolean              @default(false)
  createdAt      DateTime             @default(now())
  sizes          MenuItemSize[]
  addOns         MenuItemAddOn[]
  orderItems     OrderItem[]
  ingredients    MenuItemIngredient[]

  @@index([category])
}

model MenuItemSize {
  id              String           @id @default(cuid())
  menuItemId      String
  name            String
  priceDeltaCents Int              @default(0) // integer centavos, may be negative
  menuItem        MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  ingredients     SizeIngredient[]

  @@index([menuItemId])
}

model MenuItemAddOn {
  id              String            @id @default(cuid())
  menuItemId      String
  name            String
  priceCents      Int               @default(0) // integer centavos, >= 0
  available       Boolean           @default(true)
  noIngredients   Boolean           @default(false)
  menuItem        MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItemAddOns OrderItemAddOn[]
  ingredients     AddOnIngredient[]

  @@index([menuItemId])
}

model Order {
  id              String          @id @default(cuid())
  businessDay     String?         // YYYY-MM-DD
  dailyNumber     Int             // resets to 1 each Business_Day (2 AM Asia/Manila)
  version         Int             @default(0)
  customerName    String?
  status          OrderStatus     @default(PENDING)
  paymentMethod   PaymentMethod
  paymentRef      String?
  isPaid          Boolean         @default(false)
  refunded        Boolean         @default(false)
  totalPriceCents Int             // server-computed frozen snapshot
  costCents       Int?
  uncostedLines   Int             @default(0)
  createdById     String?
  cancelledById   String?
  cancelledAt     DateTime?
  cancelWasMade   Boolean?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           OrderItem[]
  stockMovements  StockMovement[]

  @@unique([businessDay, dailyNumber])
  @@index([createdAt])
}

model OrderItem {
  id             String           @id @default(cuid())
  orderId        String
  menuItemId     String
  sizeId         String?
  quantity       Int              // integer >= 1
  notes          String?
  lineTotalCents Int?
  costCents      Int?
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem         @relation(fields: [menuItemId], references: [id])
  size           MenuItemSize?    @relation(fields: [sizeId], references: [id])
  addOns         OrderItemAddOn[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([sizeId])
}

model OrderItemAddOn {
  id          String        @id @default(cuid())
  orderItemId String
  addOnId     String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOn       MenuItemAddOn @relation(fields: [addOnId], references: [id])

  @@index([orderItemId])
  @@index([addOnId])
}
