# Production Environment Variables Template
# Copy this to your hosting platform's environment variable settings

# PostgreSQL connection string (REQUIRED)
# Replace with your production database URL from:
# - Supabase: https://supabase.com/ (connection pooler URL recommended)
# - Neon: https://neon.tech/
# - Railway: Automatically provided
# - AWS RDS, etc.
DATABASE_URL="postgresql://username:password@host:5432/dbname?schema=public&pgbouncer=true"

# Node Environment (automatically set by most platforms)
NODE_ENV="production"

# Optional: Analytics and Monitoring
# NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_ANALYTICS_ID=""
